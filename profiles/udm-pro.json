{
  "schema_version": 1,
  "id": "udm-pro",
  "name": "UDM Pro",
  "domain": "device-research",
  "engine": {
    "track": "unifi-10.2",
    "version": "10.2.4"
  },
  "machine": "udm-pro",
  "target": "aarch64-softmmu",
  "resources": {
    "memory": "2GiB",
    "vcpus": 4,
    "accelerator": "tcg"
  },
  "external_assets": [
    {
      "id": "kernel",
      "kind": "linux-kernel",
      "required": true
    },
    {
      "id": "initrd",
      "kind": "initramfs",
      "required": true
    },
    {
      "id": "boot",
      "kind": "raw-disk",
      "required": true
    },
    {
      "id": "spi",
      "kind": "raw-disk",
      "required": true
    }
  ],
  "boot": {
    "kernel": {
      "asset": "kernel"
    },
    "initrd": {
      "asset": "initrd"
    },
    "append": "earlycon=uart8250,mmio32,0xfd883000,115200 console=ttyS0,115200 root=rootfs rootfstype=ext4 rdinit=/init loglevel=5 ip=none no_reboot systemd.mask=bluetooth-controller@hci0.service systemd.mask=reboot.target"
  },
  "storage": {
    "boot": {
      "asset": "boot",
      "format": "raw"
    },
    "spi": {
      "asset": "spi",
      "format": "raw"
    }
  },
  "network": {
    "type": "disabled"
  },
  "devices": {
    "serial": "socket"
  },
  "state": {
    "disk": "ephemeral-snapshot",
    "runtime": "per-session"
  }
}
